local hasAppliedHackLord = false

local tStyle = {
    [Enum.PoseEasingStyle.Linear] = Enum.EasingStyle.Linear,
    [Enum.PoseEasingStyle.Bounce] = Enum.EasingStyle.Bounce,
    [Enum.PoseEasingStyle.Cubic] = Enum.EasingStyle.Cubic,
    [Enum.PoseEasingStyle.Elastic] = Enum.EasingStyle.Elastic,
    [Enum.PoseEasingStyle.Constant] = Enum.EasingStyle.Linear,
}
local tDirection = {
    [Enum.PoseEasingDirection.In] = Enum.EasingDirection.In,
    [Enum.PoseEasingDirection.Out] = Enum.EasingDirection.Out,
    [Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
}

local function BuildTweens(Model, KeyFrameSequence, SpeedMult)
    SpeedMult = SpeedMult or 1
    local frames = {}
    for _, kf in ipairs(KeyFrameSequence:GetKeyframes()) do
        table.insert(frames, {Time = kf.Time, Keyframe = kf})
    end
    table.sort(frames, function(a,b) return a.Time < b.Time end)
    local tweens, motors, values, keyPoses = {}, {}, {}, {}
    local function GetMotorFromPose(pose)
        for _,v in pairs(Model:GetDescendants()) do
            if v:IsA("Motor6D") and v.Part1 and v.Part1.Name == pose.Name and v.Part0 and v.Part0.Name == pose.Parent.Name then
                return v
            end
        end
    end
    for i,frame in ipairs(frames) do
        keyPoses[i] = {Time = frame.Time, Poses={}}
        for _, pose in ipairs(frame.Keyframe:GetDescendants()) do
            if pose:IsA("Pose") and pose.Weight > 0 then
                local motor = motors[pose.Name] or GetMotorFromPose(pose)
                if motor then
                    motors[pose.Name] = motor
                    if not values[pose.Name] then
                        local cv = Instance.new("CFrameValue")
                        cv.Value = motor.Transform
                        cv.Parent = motor
                        values[pose.Name] = cv
                    end
                    keyPoses[i].Poses[pose.Name] = {Motor=motor, Pose=pose}
                end
            end
        end
    end
    if #keyPoses > 1 then
        local last = {}
        for i=1,#keyPoses-1 do
            local k1, k2 = keyPoses[i], keyPoses[i+1]
            local dur = (k2.Time - k1.Time) / SpeedMult
            tweens[i] = {Time = dur, Tweens={}}
            for n,d in pairs(k1.Poses) do last[n]=d end
            for n,d in pairs(k2.Poses) do
                if last[n] then
                    local info = TweenInfo.new(dur, tStyle[d.Pose.EasingStyle], tDirection[d.Pose.EasingDirection])
                    tweens[i].Tweens[n] = TweenService:Create(values[n], info, {Value=d.Pose.CFrame})
                end
            end
        end
    end
    local totalDuration = 0
    for _, segment in ipairs(tweens) do totalDuration = totalDuration + segment.Time end
    return tweens, motors, values, totalDuration
end

local function PlayKeyframeSequence(Model, KeyFrameSequence, SpeedMult, looped, onFinished)
    SpeedMult = SpeedMult or 1
    local tweens, motors, values, totalDuration = BuildTweens(Model, KeyFrameSequence, SpeedMult)
    local stopped = false
    local hb
    hb = RunService.Heartbeat:Connect(function()
        if stopped then if hb then hb:Disconnect() end return end
        for n,motor in pairs(motors) do motor.Transform = values[n].Value end
    end)
    local function loop()
        repeat
            for _, segment in ipairs(tweens) do
                for _, tw in pairs(segment.Tweens) do tw:Play() end
                task.wait(segment.Time)
                if stopped then break end
            end
            if not looped and not stopped then
                stopped = true
                if onFinished then onFinished() end
                break
            end
        until stopped
    end
    task.spawn(loop)
    return {
        stop = function()
            stopped = true
            if hb then hb:Disconnect() hb = nil end
            for _,v in pairs(values) do if v then v:Destroy() end end
        end,
        getLength = function() return totalDuration end
    }
end

local function getRelativeCFrame(item, referencePart)
    if not referencePart or not item then return CFrame.new() end
    if item:IsA("Attachment") then
        return referencePart.CFrame:Inverse() * (item.Parent.CFrame * item.CFrame)
    end
    return referencePart.CFrame:Inverse() * item.CFrame
end

local function weldToCharacter(character, part, targetPart, relativeCFrame, useMotor6D, offset)
    part.Anchored = false
    part.CanCollide = false
    local finalCFrame = (relativeCFrame or CFrame.new()) * (offset or CFrame.new())
    if useMotor6D then
        local motor = Instance.new("Motor6D")
        motor.Part0 = targetPart
        motor.Part1 = part
        motor.C0 = finalCFrame
        motor.C1 = CFrame.new()
        motor.Parent = character
    else
        local weld = Instance.new("Weld")
        weld.Part0 = targetPart
        weld.Part1 = part
        weld.C0 = finalCFrame
        weld.C1 = CFrame.new()
        weld.Parent = character
    end
    part.Parent = character
end

local function moveAttachmentToPlayerHead(character, attachment, hackLordHead)
    if not attachment or not hackLordHead then return end
    local relativeCFrame = getRelativeCFrame(attachment, hackLordHead)
    attachment.CFrame = relativeCFrame
    attachment.Parent = character.Head
end

local function createSafeFolder()
    local safeFolder = LocalPlayer.PlayerScripts:FindFirstChild("SavedKeyframes")
    if not safeFolder then
        safeFolder = Instance.new("Folder")
        safeFolder.Name = "SavedKeyframes"
        safeFolder.Parent = LocalPlayer.PlayerScripts
    end
    return safeFolder
end

local function CloneMe(char)
    if not char then return nil end
    char.Archivable = true
    local clone = char:Clone()
    char.Archivable = false
    return clone
end

local function setupCharacter(character)
    if hasAppliedHackLord then return end
    hasAppliedHackLord = true
    task.wait(1.5)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        task.wait(1)
        humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            return
        end
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then animator:Destroy() end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") then child:Destroy() end
    end
    for _, child in ipairs(humanoid:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("TShirt") then
            child:Destroy()
        end
    end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("TShirt") or child:IsA("Accessory") then
            child:Destroy()
        end
    end
    for _, child in ipairs(character:GetDescendants()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("TShirt") or child:IsA("Accessory") then
            child:Destroy()
        end
    end

    local bodyPartNames = {
        "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm",
        "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg",
        "RightUpperLeg", "RightLowerLeg", "LeftFoot", "RightFoot"
    }
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= character:FindFirstChild("HumanoidRootPart") then
            local isBody = false
            for _, name in ipairs(bodyPartNames) do
                if part.Name == name then isBody = true break end
            end
            if isBody then
                local isTorso = (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso")
                part.Color = isTorso and Color3.fromRGB(50, 150, 50) or Color3.new(0,0,0)
                part.Material = Enum.Material.SmoothPlastic
                if part.Name == "Head" then
                else
                    for _, child in ipairs(part:GetChildren()) do
                        if child:IsA("SpecialMesh") then child:Destroy() end
                    end
                    part.Shape = Enum.PartType.Block
                end
            end
        end
    end

    local success, model = pcall(function() return game:GetObjects("rbxassetid://102473641596712")[1] end)
    if success and model then
        local hackLord = model:FindFirstChild("HackLord")
        if hackLord then
            local hackLordHead = hackLord:FindFirstChild("Head")
            local referencePart = hackLord.PrimaryPart
            if not referencePart then
                for _, p in ipairs(hackLord:GetDescendants()) do
                    if p:IsA("BasePart") then referencePart = p break end
                end
            end
            if referencePart then
                local components = {
                    ExtraModels = hackLord:FindFirstChild("ExtraModels"),
                    Coffin = hackLord:FindFirstChild("Coffin"),
                    ErlkingCoffinChains = hackLord:FindFirstChild("ErlkingCoffinChains"),
                    HaxxedCrown = hackLord:FindFirstChild("Haxxed Crown")
                }
                for name, component in pairs(components) do
                    if component then
                        if component:IsA("Model") then
                            for _, part in ipairs(component:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    local relCF = getRelativeCFrame(part, referencePart)
                                    weldToCharacter(character, part, character.HumanoidRootPart, relCF, true)
                                end
                            end
                        elseif component:IsA("BasePart") then
                            local relCF = getRelativeCFrame(component, referencePart)
                            if name == "ErlkingCoffinChains" then
                                local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
                                if torso then weldToCharacter(character, component, torso, relCF, false)
                                else weldToCharacter(character, component, character.HumanoidRootPart, relCF, false) end
                            elseif name == "HaxxedCrown" then
                                weldToCharacter(character, component, character.Head, relCF, false, CFrame.new(0, -1.5, 0))
                            else
                                weldToCharacter(character, component, character.HumanoidRootPart, relCF, true)
                            end
                        end
                    end
                end
                if hackLordHead then
                    for _, att in ipairs(hackLordHead:GetChildren()) do
                        if att:IsA("Attachment") then moveAttachmentToPlayerHead(character, att, hackLordHead) end
                    end
                end
                local animSaves = hackLord:FindFirstChild("AnimSaves")
                if animSaves then
                    local safeFolder = createSafeFolder()
                    for _, anim in ipairs(animSaves:GetChildren()) do
                        if anim:IsA("KeyframeSequence") then
                            local clone = anim:Clone()
                            clone.Parent = safeFolder
                        end
                    end
                end
            end
        end
        model:Destroy()
    end

    local savedKeyframes = LocalPlayer.PlayerScripts:FindFirstChild("SavedKeyframes")
    if not savedKeyframes then
        return
    end

    local idleAnim = savedKeyframes:FindFirstChild("Idle")
    local walkAnim = savedKeyframes:FindFirstChild("Walk")
    local runAnim = savedKeyframes:FindFirstChild("Run")
    local executionAnim = savedKeyframes:FindFirstChild("Execution")
    local executionVictimAnim = savedKeyframes:FindFirstChild("ExecutionVictim")
    local slashKeyframe = savedKeyframes:FindFirstChild("Slash")
    local massInfectionKeyframe = savedKeyframes:FindFirstChild("Mass Infection")
    local entaglementKeyframe = savedKeyframes:FindFirstChild("Entaglement")

    if not (idleAnim and walkAnim and runAnim and slashKeyframe and massInfectionKeyframe and entaglementKeyframe) then
        return
    end

    local currentAnimObj = nil
    local isRunning = false
    local connections = {}
    local footstepCoroutine = nil
    local isPlayingAbility = false
    local abilityDebounces = {}

    local function playAnimation(anim, speedMult, looped, onFinish)
        if currentAnimObj then
            currentAnimObj.stop()
            currentAnimObj = nil
        end
        if anim then
            currentAnimObj = PlayKeyframeSequence(character, anim, speedMult or 2, looped, onFinish)
        end
    end

    local sound1 = Instance.new("Sound", character.HumanoidRootPart)
    sound1.SoundId = "rbxassetid://131164918216963"
    local sound2 = Instance.new("Sound", character.HumanoidRootPart)
    sound2.SoundId = "rbxassetid://87336115451799"
    local currentSound = 1
    local function playFootstep()
        (currentSound == 1 and sound1 or sound2):Play()
        currentSound = 3 - currentSound
    end
    function startFootsteps()
        if footstepCoroutine then coroutine.close(footstepCoroutine) end
        footstepCoroutine = coroutine.create(function()
            while humanoid and humanoid.MoveDirection.Magnitude > 0 and humanoid.WalkSpeed > 2 and not isPlayingAbility do
                playFootstep()
                task.wait(isRunning and 0.5 or 0.7)
            end
        end)
        coroutine.resume(footstepCoroutine)
    end
    function stopFootsteps()
        if footstepCoroutine then coroutine.close(footstepCoroutine) footstepCoroutine = nil end
    end

    local screenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
    screenGui.Name = "HackLordUI"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.DisplayOrder = 999

    local toggleButton = Instance.new("ImageButton", screenGui)
    toggleButton.Size = UDim2.new(0, 100, 0, 100)
    toggleButton.Position = UDim2.new(0, 20, 1, -120)
    toggleButton.BackgroundTransparency = 1
    toggleButton.Image = "rbxassetid://132640025048316"
    toggleButton.ZIndex = 10

    local abilities = {
        ["Entaglement"] = {
            keyframe = entaglementKeyframe,
            cooldown = 7,
            extraWait = 0.5,
            sound = "rbxassetid://85739345749675",
            image = "rbxassetid://119069138923680",
            extraLogic = nil
        },
        ["Mass Infection"] = {
            keyframe = massInfectionKeyframe,
            cooldown = 7,
            extraWait = 1,
            sound = "rbxassetid://108321828055199",
            image = "rbxassetid://112065267803856",
            extraLogic = function()
                task.spawn(function()
                    local hrp = character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local proj = Instance.new("MeshPart")
                        proj.MeshId = "rbxassetid://2836527412"
                        proj.Color = Color3.new(0, 1, 0)
                        proj.Size = Vector3.new(1, 1, 1)
                        proj.CFrame = hrp.CFrame * CFrame.new(0, 0, -3)
                        proj.Anchored = true
                        proj.CanCollide = false
                        proj.Parent = Workspace
                        local moveConn = RunService.Heartbeat:Connect(function(dt)
                            if proj and proj.Parent then
                                proj.CFrame = proj.CFrame * CFrame.new(0, 0, -50 * dt)
                            end
                        end)
                        task.delay(6, function()
                            if moveConn then moveConn:Disconnect() end
                            if proj and proj.Parent then proj:Destroy() end
                        end)
                    end
                end)
            end
        },
        ["Slash"] = {
            keyframe = slashKeyframe,
            cooldown = 2,
            extraWait = 0.5,
            sound = "rbxassetid://98622759453637",
            image = "rbxassetid://120590195585579",
            extraLogic = function()
                task.spawn(function()
                    local hitbox = Instance.new("Part")
                    hitbox.Size = Vector3.new(3, 3, 5)
                    hitbox.Transparency = 1
                    hitbox.CanCollide = false
                    hitbox.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                    hitbox.Parent = Workspace
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = character.HumanoidRootPart
                    weld.Part1 = hitbox
                    weld.Parent = hitbox
                    local conn
                    conn = hitbox.Touched:Connect(function(hit)
                        if not hit or not hit.Parent then return end
                        if hit:IsDescendantOf(character) then return end
                        local targetChar = hit:FindFirstAncestorWhichIsA("Model")
                        if not targetChar then return end
                        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
                        if not targetHum then return end
                        local targetPlayer = Players:GetPlayerFromCharacter(targetChar)
                        if not targetPlayer then return end
                        local dmg = 20
                        if targetHum.Health - dmg <= 0 then
                            targetHum.Health = 1
                            local charClone = CloneMe(targetChar)
                            if charClone then
                                charClone.Parent = Workspace
                                local cloneHRP = charClone:FindFirstChild("HumanoidRootPart")
                                if cloneHRP then
                                    cloneHRP.CFrame = character.HumanoidRootPart.CFrame
                                    local cloneWeld = Instance.new("WeldConstraint")
                                    cloneWeld.Part0 = character.HumanoidRootPart
                                    cloneWeld.Part1 = cloneHRP
                                    cloneWeld.Parent = cloneHRP
                                    PlayKeyframeSequence(character, executionAnim, 2, false, function()
                                        if charClone and charClone.Parent then charClone:Destroy() end
                                    end)
                                    if executionVictimAnim then
                                        PlayKeyframeSequence(charClone, executionVictimAnim, 2, false, function()
                                            if charClone and charClone.Parent then charClone:Destroy() end
                                        end)
                                    end
                                    targetHum:TakeDamage(dmg)
                                    targetHum.Health = targetHum.MaxHealth
                                end
                            end
                            if conn then conn:Disconnect() end
                            if hitbox and hitbox.Parent then hitbox:Destroy() end
                        else
                            targetHum:TakeDamage(dmg)
                            if conn then conn:Disconnect() end
                            if hitbox and hitbox.Parent then hitbox:Destroy() end
                        end
                    end)
                    task.delay(2, function()
                        if conn then conn:Disconnect() end
                        if hitbox and hitbox.Parent then hitbox:Destroy() end
                    end)
                end)
            end
        }
    }

    local abilityOrder = {"Entaglement", "Mass Infection", "Slash"}
    local buttonYOffsets = {-400, -300, -200}

    for i, name in ipairs(abilityOrder) do
        local data = abilities[name]
        if data then
            local yOffset = buttonYOffsets[i]
            local btn = Instance.new("ImageButton", screenGui)
            btn.Size = UDim2.new(0, 90, 0, 90)
            btn.Position = UDim2.new(1, -100, 1, yOffset)
            btn.BackgroundTransparency = 1
            btn.Image = data.image
            btn.ZIndex = 10
            local corner = Instance.new("UICorner", btn)
            corner.CornerRadius = UDim.new(1, 0)

            abilityDebounces[name] = false

            connections[name] = btn.MouseButton1Click:Connect(function()
                if isPlayingAbility or abilityDebounces[name] then return end
                isPlayingAbility = true
                abilityDebounces[name] = true

                btn.ImageTransparency = 0.5
                task.delay(data.cooldown, function()
                    abilityDebounces[name] = false
                    btn.ImageTransparency = 0
                end)

                humanoid.WalkSpeed = 2
                stopFootsteps()
                if currentAnimObj then currentAnimObj.stop() currentAnimObj = nil end

                PlayKeyframeSequence(character, data.keyframe, 2, false)
                if data.sound then
                    local s = Instance.new("Sound", character.HumanoidRootPart)
                    s.SoundId = data.sound
                    s:Play()
                    s.Ended:Connect(function() s:Destroy() end)
                end
                if data.extraLogic then data.extraLogic() end

                local length = 0
                local ok, obj = pcall(function() return PlayKeyframeSequence(character, data.keyframe, 2, false) end)
                if ok and obj and obj.getLength then
                    length = obj.getLength()
                    obj.stop()
                end
                task.wait(length + (data.extraWait or 0))

                isPlayingAbility = false
                humanoid.WalkSpeed = isRunning and 28 or 16
                if humanoid.MoveDirection.Magnitude > 0 then
                    playAnimation(isRunning and runAnim or walkAnim, 2, true)
                    startFootsteps()
                else
                    playAnimation(idleAnim, 2, true)
                end
            end)
        end
    end

    local lastMagnitude = 0
    connections.move = RunService.Heartbeat:Connect(function()
        if not humanoid or not character.Parent or isPlayingAbility then return end
        local magnitude = humanoid.MoveDirection.Magnitude
        if magnitude > 0 and lastMagnitude == 0 and humanoid.WalkSpeed > 2 then
            startFootsteps()
            playAnimation(isRunning and runAnim or walkAnim, 2, true)
        elseif magnitude == 0 and lastMagnitude > 0 then
            stopFootsteps()
            playAnimation(idleAnim, 2, true)
        end
        lastMagnitude = magnitude
    end)

    connections.cleanup = character.AncestryChanged:Connect(function()
        if not character.Parent then
            for _, conn in pairs(connections) do
                if conn and typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
            end
            stopFootsteps()
            if screenGui and screenGui.Parent then screenGui:Destroy() end
        end
    end)

    local function toggleRunState()
        isRunning = not isRunning
        humanoid.WalkSpeed = isRunning and 28 or 16
        if humanoid.MoveDirection.Magnitude > 0 and not isPlayingAbility then
            playAnimation(isRunning and runAnim or walkAnim, 2, true)
        end
    end
    connections.toggle = toggleButton.MouseButton1Click:Connect(toggleRunState)

    humanoid.WalkSpeed = 16
    playAnimation(idleAnim, 2, true)
end

local function onCharacterAdded(character)
    if not hasAppliedHackLord then
        task.wait(0.5)
        setupCharacter(character)
    end
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
if LocalPlayer.Character then
    onCharacterAdded(LocalPlayer.Character)
end
